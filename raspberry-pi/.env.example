# Skopiuj do .env i dostosuj. Zmienne ustawione w środowisku mają pierwszeństwo nad .env.

HUB_ID=hub1
LOG_LEVEL=INFO

# --- MQTT ---
# Na Pi: localhost. Na PC: adres IP Raspberry Pi albo lokalny Mosquitto.
MQTT_HOST=localhost
MQTT_PORT=1883
# MQTT_CLIENT_ID=hub1-pi
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE_S=30
MQTT_RECONNECT_MIN_DELAY_S=1
MQTT_RECONNECT_MAX_DELAY_S=30

# --- GPIO (numeracja BCM) ---
# true = tryb mock bez GPIO (testy na PC)
GPIO_MOCK=true
GPIO_DHT22=4
GPIO_PIR=27
GPIO_RELAY_LED=17
GPIO_RELAY_HEATER=22

# --- Interwały ---
# DHT22: minimum 2 s
DHT22_INTERVAL_S=10

# --- Fail-safe grzałki ---
# Brak komendy heater/set przez tyle sekund oznacza OFF
HEATER_COMMAND_TIMEOUT_S=30
# Temperatura powyżej progu oznacza OFF
HEATER_MAX_TEMPERATURE_C=35
# Tyle kolejnych nieudanych odczytów DHT22 oznacza OFF
HEATER_MAX_INVALID_READINGS=3
