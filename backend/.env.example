# Skopiuj do .env (w katalogu backend/) i uzupełnij. Zmienne środowiskowe mają pierwszeństwo.

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/smarthome
DB_USERNAME=smarthome
DB_PASSWORD=

# --- MQTT (Mosquitto na Raspberry Pi) ---
# Nazwa hosta Pi albo jego adres IP, np. tcp://192.168.1.50:1883
MQTT_BROKER_URL=tcp://kamil.local:1883
MQTT_CLIENT_ID=smarthome-backend
MQTT_USERNAME=
MQTT_PASSWORD=

# --- JWT (etap 3), co najmniej 32 znaki ---
JWT_SECRET=

# DEBUG pokazuje każdą wiadomość MQTT z huba
LOG_LEVEL=INFO
